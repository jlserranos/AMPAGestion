@page "/alumnos/etiquetas"
@using AMPAGestion.Services
@using AMPAGestion.Models
@inject AlumnoService AlumnoSvc
@inject IJSRuntime JS
@inject Blazored.Toast.Services.IToastService Toast

<PageTitle>Imprimir etiquetas · AMPA Gestión</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/alumnos" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    <h4 class="fw-bold mb-0"><i class="bi bi-tag me-2"></i>Imprimir etiquetas de alumnos</h4>
</div>

<div class="row g-3">

    <!-- Panel izquierdo: configuración -->
    <div class="col-lg-5">

        <!-- Selección de alumnos -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-people me-2 text-primary"></i>Alumnos
                        <span class="badge bg-primary ms-1">@alumnosSeleccionados.Count seleccionados</span>
                    </h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" @onclick="SeleccionarTodos">Todos</button>
                        <button class="btn btn-outline-secondary" @onclick="SeleccionarNinguno">Ninguno</button>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-7">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Filtrar alumnos..."
                                   value="@filtroAlumnos" @oninput="OnFiltroInput" />
                        </div>
                    </div>
                    <div class="col-5">
                        <select class="form-select form-select-sm" @bind="filtroCurso">
                            <option value="">Todos los cursos</option>
                            @foreach (var c in cursosDisponibles)
                            {
                                <option value="@c.Curso">@c.Descripcion</option>
                            }
                        </select>
                    </div>
                </div>
                <div style="max-height:280px;overflow-y:auto" class="border rounded p-2">
                    @foreach (var a in alumnosFiltrados)
                    {
                        <div class="d-flex align-items-center gap-2 py-1 border-bottom">
                            <input type="checkbox" class="form-check-input mt-0"
                                   checked="@alumnosSeleccionados.Contains(a.Id)"
                                   @onchange="() => ToggleAlumno(a.Id)" />
                            <div style="font-size:.88rem">
                                <span class="fw-semibold">@a.Nombre @a.Apellidos</span>
                                <small class="text-muted ms-1">@a.CursoDescripcion</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Tamaño y página -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-rulers me-2 text-primary"></i>Tamaño y distribución
                </h6>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label" style="font-size:.82rem">Ancho (mm)</label>
                        <input type="number" class="form-control form-control-sm"
                               @bind="anchoMm" min="30" max="200" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" style="font-size:.82rem">Alto (mm)</label>
                        <input type="number" class="form-control form-control-sm"
                               @bind="altoMm" min="15" max="280" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label" style="font-size:.82rem">Predefinidos</label>
                    <div class="d-flex gap-1 flex-wrap">
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                style="font-size:.78rem" @onclick="() => SetTamano(90,55)">Tarjeta 90×55</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                style="font-size:.78rem" @onclick="() => SetTamano(70,37)">Estándar 70×37</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                style="font-size:.78rem" @onclick="() => SetTamano(105,74)">Grande 105×74</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                style="font-size:.78rem" @onclick="() => SetTamano(50,50)">Cuadrada 50×50</button>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label" style="font-size:.82rem">Columnas por página</label>
                        <select class="form-select form-select-sm" @bind="columnasPagina">
                            <option value="1">1 columna</option>
                            <option value="2">2 columnas</option>
                            <option value="3">3 columnas</option>
                            <option value="4">4 columnas</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" style="font-size:.82rem">Separación entre etiquetas (mm)</label>
                        <input type="number" class="form-control form-control-sm" step="0.5"
                               @bind="separacionMm" @bind:after="Normalizar" min="0" max="20" />
                    </div>
                </div>

                <label class="form-label fw-semibold" style="font-size:.82rem">
                    Márgenes de página (mm) <span class="text-muted fw-normal">· mínimo @MargenMinimo mm</span>
                </label>
                <div class="row g-2">
                    <div class="col-3">
                        <label class="form-label mb-0 text-muted" style="font-size:.75rem">Superior</label>
                        <input type="number" class="form-control form-control-sm" step="0.5"
                               @bind="margenSup" @bind:after="Normalizar" min="@MargenMinimo" max="60" />
                    </div>
                    <div class="col-3">
                        <label class="form-label mb-0 text-muted" style="font-size:.75rem">Inferior</label>
                        <input type="number" class="form-control form-control-sm" step="0.5"
                               @bind="margenInf" @bind:after="Normalizar" min="@MargenMinimo" max="60" />
                    </div>
                    <div class="col-3">
                        <label class="form-label mb-0 text-muted" style="font-size:.75rem">Izquierdo</label>
                        <input type="number" class="form-control form-control-sm" step="0.5"
                               @bind="margenIzq" @bind:after="Normalizar" min="@MargenMinimo" max="60" />
                    </div>
                    <div class="col-3">
                        <label class="form-label mb-0 text-muted" style="font-size:.75rem">Derecho</label>
                        <input type="number" class="form-control form-control-sm" step="0.5"
                               @bind="margenDer" @bind:after="Normalizar" min="@MargenMinimo" max="60" />
                    </div>
                </div>

                @if (MaxColumnas < 1 || FilasPagina < 1)
                {
                    <div class="alert alert-danger py-1 px-2 mt-2 mb-0" style="font-size:.8rem">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        La etiqueta no cabe en el área imprimible de un A4 con estos márgenes.
                    </div>
                }
                else
                {
                    <div class="mt-2 text-muted" style="font-size:.8rem">
                        <i class="bi bi-grid-3x3 me-1"></i>
                        @ColumnasEfectivas × @FilasPagina etiquetas por página A4
                        @if (alumnosSeleccionados.Count > 0)
                        {
                            <span> · @Paginas página@(Paginas != 1 ? "s" : "")</span>
                        }
                    </div>
                    @if (columnasPagina > MaxColumnas)
                    {
                        <div class="alert alert-warning py-1 px-2 mt-2 mb-0" style="font-size:.8rem">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Solo caben @MaxColumnas columna@(MaxColumnas != 1 ? "s" : "") dentro de los márgenes;
                            se imprimirán @MaxColumnas.
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Texto -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-fonts me-2 text-primary"></i>Texto de la etiqueta
                </h6>

                <div class="mb-3">
                    <label class="form-label" style="font-size:.82rem">Título principal</label>
                    <input type="text" class="form-control form-control-sm" @bind="textTitulo"
                           placeholder="Ej: BOCADILLO DE QUESO" />
                    @EditorEstilo(estiloTitulo)
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-size:.82rem">Nombre del alumno</label>
                    <select class="form-select form-select-sm" @bind="modoNombre">
                        <option value="nombre">Solo nombre</option>
                        <option value="apellidos">Solo apellidos</option>
                        <option value="completo">Nombre completo</option>
                        <option value="ninguno">No mostrar nombre</option>
                    </select>
                    <div class="form-check mt-1">
                        <input type="checkbox" class="form-check-input" id="chkCurso" @bind="mostrarCurso" />
                        <label class="form-check-label" for="chkCurso" style="font-size:.82rem">
                            Añadir curso y grupo tras el nombre (Ej: Ana López - 1º ESO A)
                        </label>
                    </div>
                    @EditorEstilo(estiloNombre)
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-size:.82rem">Texto adicional</label>
                    <textarea class="form-control form-control-sm" rows="2" @bind="textAdicional"
                              placeholder="Ej: Excursión · 15 junio 2025"></textarea>
                    @EditorEstilo(estiloAdicional)
                </div>

                <div class="row g-2 align-items-center">
                    <div class="col-8">
                        <label class="form-label mb-0" style="font-size:.82rem">
                            Espacio entre título, nombre y texto adicional (mm)
                        </label>
                    </div>
                    <div class="col-4">
                        <input type="number" class="form-control form-control-sm" min="0" max="10" step="0.5"
                               @bind="espaciadoTextoMm" @bind:after="Normalizar" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Texto inferior izquierdo de cada etiqueta -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-text-left me-2 text-primary"></i>Texto inferior izquierdo de la etiqueta
                    </h6>
                    <div class="form-check form-switch mb-0">
                        <input type="checkbox" class="form-check-input" id="chkPie" @bind="mostrarPie" />
                        <label class="form-check-label" for="chkPie" style="font-size:.82rem">Mostrar</label>
                    </div>
                </div>
                @if (mostrarPie)
                {
                    <input type="text" class="form-control form-control-sm" @bind="textoPie" />
                    @EditorEstilo(estiloPie)
                }
            </div>
        </div>

        <!-- Imágenes -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-image me-2 text-primary"></i>Imágenes
                </h6>
                <div class="mb-3">
                    <label class="form-label" style="font-size:.82rem">
                        <i class="bi bi-image-fill me-1 text-primary"></i>Imagen izquierda (logo)
                    </label>
                    @if (!string.IsNullOrEmpty(imgIzqData))
                    {
                        <div class="d-flex align-items-center gap-2">
                            <img src="@imgIzqData" style="height:40px;border-radius:4px" alt="Logo" />
                            <button class="btn btn-sm btn-outline-danger py-0"
                                    @onclick="QuitarImgIzq">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <label class="btn btn-sm btn-outline-secondary w-100 cursor-pointer">
                            <i class="bi bi-upload me-1"></i>Subir imagen
                            <InputFile OnChange="CargarImgIzq" accept="image/*" class="d-none" />
                        </label>
                    }
                </div>
                <div>
                    <label class="form-label" style="font-size:.82rem">
                        <i class="bi bi-layers me-1 text-secondary"></i>Imagen de fondo (difuminada)
                    </label>
                    @if (!string.IsNullOrEmpty(imgFondoData))
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <img src="@imgFondoData" style="height:40px;border-radius:4px;opacity:.4" alt="Fondo" />
                            <button class="btn btn-sm btn-outline-danger py-0"
                                    @onclick="QuitarImgFondo">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                        <label class="form-label" style="font-size:.82rem">
                            Opacidad del fondo (@opacidadFondo%)
                        </label>
                        <input type="range" class="form-range" min="5" max="50" @bind="opacidadFondo" />
                    }
                    else
                    {
                        <label class="btn btn-sm btn-outline-secondary w-100 cursor-pointer">
                            <i class="bi bi-upload me-1"></i>Subir imagen de fondo
                            <InputFile OnChange="CargarImgFondo" accept="image/*" class="d-none" />
                        </label>
                    }
                </div>
            </div>
        </div>

        <button class="btn btn-primary w-100 btn-lg"
                @onclick="Imprimir"
                disabled="@(alumnosSeleccionados.Count == 0 || ColumnasEfectivas < 1 || FilasPagina < 1)">
            <i class="bi bi-printer me-2"></i>
            Imprimir @alumnosSeleccionados.Count
            etiqueta@(alumnosSeleccionados.Count != 1 ? "s" : "")
        </button>
    </div>

    <!-- Panel derecho: previsualización -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-eye me-2 text-primary"></i>Previsualización
                </h6>
                @if (alumnosSeleccionados.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-tag fs-1 d-block mb-2 opacity-25"></i>
                        Selecciona alumnos para ver la previsualización
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap" style="gap:@Px(separacionMm)px">
                        @foreach (var id in alumnosSeleccionados.Take(6))
                        {
                            var alumno = todosAlumnos.FirstOrDefault(a => a.Id == id);
                            if (alumno == null) continue;
                            var nombre = ObtenerNombreEtiqueta(alumno);

                            <!-- La URL de fondo se construye en C# para evitar problemas
                                 con comillas simples dentro de estilos en Razor -->
                            <div style="@EtiquetaContainerStyle() border:1px solid #dee2e6;border-radius:6px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
                                @if (!string.IsNullOrEmpty(imgFondoData))
                                {
                                    <div style="@FondoStyle()"></div>
                                }
                                <div style="position:relative;display:flex;flex-direction:column;height:100%;padding:@Px(altoMm * 0.07)px @Px(anchoMm * 0.04)px;z-index:1">
                                <div style="flex:1;min-height:0;display:flex;align-items:center;gap:@Px(anchoMm * 0.03)px">
                                    @if (!string.IsNullOrEmpty(imgIzqData))
                                    {
                                        <img src="@imgIzqData"
                                             style="height:72%;object-fit:contain;flex-shrink:0;max-width:28%" />
                                    }
                                    <div style="flex:1;min-width:0;overflow:hidden;display:flex;flex-direction:column;gap:@Px(espaciadoTextoMm)px">
                                        @if (!string.IsNullOrEmpty(textTitulo))
                                        {
                                            <div style="@EstiloPreview(estiloTitulo)">@textTitulo</div>
                                        }
                                        @if (!string.IsNullOrEmpty(nombre))
                                        {
                                            <div style="@EstiloPreview(estiloNombre)">@nombre</div>
                                        }
                                        @if (!string.IsNullOrEmpty(textAdicional))
                                        {
                                            <div style="@EstiloPreview(estiloAdicional)">@textAdicional</div>
                                        }
                                    </div>
                                </div>
                                @if (mostrarPie && !string.IsNullOrWhiteSpace(textoPie))
                                {
                                    <div style="@EstiloPreview(estiloPie) flex-shrink:0;text-align:left">@textoPie</div>
                                }
                                </div>
                            </div>
                        }
                        @if (alumnosSeleccionados.Count > 6)
                        {
                            <div class="text-muted align-self-center" style="font-size:.85rem">
                                +@(alumnosSeleccionados.Count - 6) más...
                            </div>
                        }
                    </div>

                }
            </div>
        </div>
    </div>
</div>

@code {
    // ── Constantes de página ────────────────────────────────────────────────
    const double PxPorMm      = 3.7795275591;   // 96 dpi
    const double A4AnchoMm    = 210;
    const double A4AltoMm     = 297;
    const double MargenMinimo = 5;              // área no imprimible típica de impresoras
    const double EscalaPreview = 1.8;           // px por mm en la previsualización

    List<Alumno>  todosAlumnos          = new();
    HashSet<int>  alumnosSeleccionados  = new();
    string        filtroAlumnos         = string.Empty;

    // ── Tamaño y distribución ──────────────────────────────────────────────
    int    anchoMm        = 90;
    int    altoMm         = 55;
    int    columnasPagina = 2;
    double separacionMm   = 4;
    double margenSup      = 10;
    double margenInf      = 10;
    double margenIzq      = 10;
    double margenDer      = 10;

    // ── Textos ─────────────────────────────────────────────────────────────
    string textTitulo     = string.Empty;
    string textAdicional  = string.Empty;
    string modoNombre     = "completo";
    bool   mostrarCurso   = true;
    double espaciadoTextoMm = 1.5;

    bool   mostrarPie     = true;
    string textoPie       = "AMPA San Sebastián - IES Montevives";

    public class EstiloTexto
    {
        public int    Tamano  { get; set; }
        public string Color   { get; set; } = "#000000";
        public string Fuente  { get; set; } = "Arial, Helvetica, sans-serif";
        public bool   Negrita { get; set; }
    }

    EstiloTexto estiloTitulo    = new() { Tamano = 14, Color = "#1a1a2e", Negrita = true };
    EstiloTexto estiloNombre    = new() { Tamano = 12, Color = "#e63946", Negrita = true };
    EstiloTexto estiloAdicional = new() { Tamano = 10, Color = "#555555" };
    EstiloTexto estiloPie       = new() { Tamano = 9,  Color = "#6c757d" };

    record Fuente(string Nombre, string Valor);
    static readonly Fuente[] fuentesDisponibles =
    {
        new("Arial",           "Arial, Helvetica, sans-serif"),
        new("Calibri",         "Calibri, Carlito, sans-serif"),
        new("Segoe UI",        "'Segoe UI', Tahoma, sans-serif"),
        new("Verdana",         "Verdana, Geneva, sans-serif"),
        new("Tahoma",          "Tahoma, Geneva, sans-serif"),
        new("Trebuchet MS",    "'Trebuchet MS', sans-serif"),
        new("Georgia",         "Georgia, serif"),
        new("Times New Roman", "'Times New Roman', Times, serif"),
        new("Courier New",     "'Courier New', Courier, monospace"),
        new("Comic Sans MS",   "'Comic Sans MS', 'Comic Sans', cursive")
    };

    // ── Imágenes ───────────────────────────────────────────────────────────
    string imgIzqData     = string.Empty;
    string imgFondoData   = string.Empty;
    int    opacidadFondo  = 20;

    string        filtroCurso           = string.Empty;

    // ── Cálculo de distribución en A4 ──────────────────────────────────────
    double AnchoUtilMm => A4AnchoMm - margenIzq - margenDer;
    double AltoUtilMm  => A4AltoMm  - margenSup - margenInf;

    int MaxColumnas => anchoMm <= 0 ? 0 : (int)Math.Floor((AnchoUtilMm + separacionMm) / (anchoMm + separacionMm));
    int FilasPagina => altoMm  <= 0 ? 0 : (int)Math.Floor((AltoUtilMm  + separacionMm) / (altoMm  + separacionMm));
    int ColumnasEfectivas => Math.Min(columnasPagina, MaxColumnas);
    int Paginas => ColumnasEfectivas < 1 || FilasPagina < 1 ? 0
        : (int)Math.Ceiling(alumnosSeleccionados.Count / (double)(ColumnasEfectivas * FilasPagina));

    void Normalizar()
    {
        margenSup = Math.Max(MargenMinimo, margenSup);
        margenInf = Math.Max(MargenMinimo, margenInf);
        margenIzq = Math.Max(MargenMinimo, margenIzq);
        margenDer = Math.Max(MargenMinimo, margenDer);
        separacionMm = Math.Clamp(separacionMm, 0, 20);
        espaciadoTextoMm = Math.Clamp(espaciadoTextoMm, 0, 10);
        foreach (var e in new[] { estiloTitulo, estiloNombre, estiloAdicional, estiloPie })
            e.Tamano = Math.Clamp(e.Tamano, 6, 40);
    }

    // ── Editor de estilo reutilizable (tamaño, color, fuente, negrita) ─────
    RenderFragment EditorEstilo(EstiloTexto e) => @<div class="row g-2 mt-1 align-items-end">
        <div class="col-5">
            <label class="form-label mb-0 text-muted" style="font-size:.75rem">Fuente</label>
            <select class="form-select form-select-sm" @bind="e.Fuente" style="font-family:@e.Fuente">
                @foreach (var f in fuentesDisponibles)
                {
                    <option value="@f.Valor" style="font-family:@f.Valor">@f.Nombre</option>
                }
            </select>
        </div>
        <div class="col-3">
            <label class="form-label mb-0 text-muted" style="font-size:.75rem">Tamaño (px)</label>
            <input type="number" class="form-control form-control-sm" min="6" max="40" @bind="e.Tamano" />
        </div>
        <div class="col-2">
            <label class="form-label mb-0 text-muted" style="font-size:.75rem">Color</label>
            <input type="color" class="form-control form-control-sm form-control-color w-100 p-1" @bind="e.Color" />
        </div>
        <div class="col-2">
            <button type="button" title="Negrita"
                    class="btn btn-sm w-100 @(e.Negrita ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick="() => e.Negrita = !e.Negrita">
                <i class="bi bi-type-bold"></i>
            </button>
        </div>
    </div>;

    // ── Previsualización ───────────────────────────────────────────────────
    static string Num(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    static string Px(double mm) => Num(mm * EscalaPreview);

    string EstiloPreview(EstiloTexto e)
        => $"font-size:{Num(e.Tamano * EscalaPreview / PxPorMm)}px;font-family:{e.Fuente};color:{e.Color};" +
           $"font-weight:{(e.Negrita ? 700 : 400)};line-height:1.15;" +
           "white-space:nowrap;overflow:hidden;text-overflow:ellipsis;";

    // Cursos presentes entre los alumnos cargados, en el orden del enum
    IEnumerable<(string Curso, string Descripcion)> cursosDisponibles => todosAlumnos
        .GroupBy(a => a.Curso)
        .OrderBy(g => g.Key)
        .Select(g => (g.Key.ToString(), g.First().CursoDescripcion));

    IEnumerable<Alumno> alumnosFiltrados => todosAlumnos
        .Where(a => string.IsNullOrEmpty(filtroCurso) || a.Curso.ToString() == filtroCurso)
        .Where(a => string.IsNullOrWhiteSpace(filtroAlumnos) ||
            a.Nombre.Contains(filtroAlumnos, StringComparison.OrdinalIgnoreCase) ||
            (a.Apellidos != null && a.Apellidos.Contains(filtroAlumnos, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
        => todosAlumnos = await AlumnoSvc.GetTodosAsync();

    void OnFiltroInput(ChangeEventArgs e)
        => filtroAlumnos = e.Value?.ToString() ?? string.Empty;

    void SeleccionarTodos()
    {
        foreach (var a in alumnosFiltrados) alumnosSeleccionados.Add(a.Id);
    }

    void SeleccionarNinguno() => alumnosSeleccionados.Clear();
    void ToggleAlumno(int id)
    {
        if (alumnosSeleccionados.Contains(id)) alumnosSeleccionados.Remove(id);
        else alumnosSeleccionados.Add(id);
    }

    void SetTamano(int w, int h) { anchoMm = w; altoMm = h; }
    void QuitarImgIzq()   => imgIzqData   = string.Empty;
    void QuitarImgFondo() => imgFondoData = string.Empty;

    // Estilos construidos en C# para evitar CS1011 con comillas simples en url() dentro de Razor
    string EtiquetaContainerStyle()
        => $"width:{Px(anchoMm)}px;height:{Px(altoMm)}px;" +
           "background:white;position:relative;overflow:hidden;display:inline-block;";

    string FondoStyle()
    {
        // Las comillas simples dentro de url() se generan en C# sin problema
        string bg = !string.IsNullOrEmpty(imgFondoData)
            ? $"background-image:url('{imgFondoData}');"
            : string.Empty;
        return $"position:absolute;inset:0;{bg}background-size:cover;" +
               $"background-position:center;opacity:{Num(opacidadFondo / 100.0)};filter:blur(3px);";
    }

    string ObtenerNombreEtiqueta(Alumno a)
    {
        var nombre = (modoNombre switch
        {
            "nombre"    => a.Nombre,
            "apellidos" => a.Apellidos ?? string.Empty,
            "completo"  => $"{a.Nombre} {a.Apellidos}",
            _           => string.Empty
        }).Trim();

        if (!mostrarCurso) return nombre;

        var curso = string.IsNullOrWhiteSpace(a.Grupo)
            ? a.CursoDescripcion
            : $"{a.CursoDescripcion} {a.Grupo.Trim()}";

        return string.IsNullOrEmpty(nombre) ? curso : $"{nombre} - {curso}";
    }

    async Task CargarImgIzq(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo.Size > 5 * 1024 * 1024) { Toast.ShowError("Máx 5 MB"); return; }
        using var stream = archivo.OpenReadStream(5 * 1024 * 1024);
        using var ms     = new MemoryStream();
        await stream.CopyToAsync(ms);
        imgIzqData = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    async Task CargarImgFondo(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo.Size > 5 * 1024 * 1024) { Toast.ShowError("Máx 5 MB"); return; }
        using var stream = archivo.OpenReadStream(5 * 1024 * 1024);
        using var ms     = new MemoryStream();
        await stream.CopyToAsync(ms);
        imgFondoData = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    async Task Imprimir()
    {
        Normalizar();
        if (ColumnasEfectivas < 1 || FilasPagina < 1)
        {
            Toast.ShowError("La etiqueta no cabe en el área imprimible con estos márgenes.");
            return;
        }

        var nombres = todosAlumnos
            .Where(a => alumnosSeleccionados.Contains(a.Id))
            .Select(ObtenerNombreEtiqueta)
            .ToArray();

        try
        {
            await JS.InvokeVoidAsync("imprimirEtiquetas", new
            {
                nombres,
                titulo           = textTitulo,
                textoAdicional   = textAdicional,
                anchoMm,
                altoMm,
                columnas         = ColumnasEfectivas,
                filas            = FilasPagina,
                separacionMm,
                espaciadoTextoMm,
                margenes         = new { superior = margenSup, inferior = margenInf, izquierdo = margenIzq, derecho = margenDer },
                    estiloTitulo,
                estiloNombre,
                estiloAdicional,
                estiloPie,
                mostrarPie       = mostrarPie && !string.IsNullOrWhiteSpace(textoPie),
                textoPie,
                imgIzqData,
                imgFondoData,
                opacidadFondo
            });
        }
        catch (JSException ex)
        {
            // Sin capturar, la excepción tumba el circuito de Blazor y la página deja de responder
            Toast.ShowError($"No se pudo imprimir: {ex.Message}. Recarga la página con Ctrl+F5.");
        }
        catch (TaskCanceledException)
        {
            Toast.ShowError("La impresión tardó demasiado en prepararse. Vuelve a intentarlo.");
        }
    }
}
